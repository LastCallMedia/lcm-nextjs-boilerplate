{
  "name": "lcm-nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:seed-posts": "tsx --env-file=.env prisma/seed-posts.ts",
    "db:reset": "prisma migrate reset",
    "dev": "pnpm docker:dev && next dev --webpack",
    "dev:turbo": "pnpm docker:dev && next dev --turbo",
    "dev:only": "next dev --webpack",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "postinstall": "prisma generate",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:cypress": "cd tests && pnpm cypress:run",
    "test:cypress:open": "cd tests && pnpm cypress:open",
    "test:cypress:test": "cd tests && pnpm cypress:test",
    "test:cypress:convert": "cd tests && pnpm convert:playwright",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "install:playwright": "playwright install",
    "clean": "rm -rf .next out node_modules/.cache",
    "docker:dev": "docker compose up -d postgres mailhog",
    "docker:dev:down": "docker compose down",
    "docker:prod": "docker compose --env-file .env.docker up -d",
    "docker:prod:down": "docker compose --env-file .env.docker down",
    "docker:build": "docker compose build",
    "act:full": "act",
    "act:lint": "act -j code-quality",
    "act:jest": "act -j jest-tests",
    "act:e2e": "act -j e2e-tests",
    "vercel-build": "prisma generate && next build",
    "vercel-deploy": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^2.0.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^1.4.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/nodemailer": "^8.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fast-xml-parser": "^5.11.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.552.0",
    "next": "^16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "react": "^19.2.8",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-intl": "^7.1.14",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.10.1",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "swagger-ui-react": "^5.32.15",
    "tailwind-merge": "^3.6.0",
    "trpc-to-openapi": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/swagger-ui-react": "^5.18.0",
    "axe-core": "^4.13.0",
    "cheerio": "^1.2.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.5.1",
    "postcss": "8.5.23",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "0.7.4",
    "prisma": "^6.19.3",
    "smtp-tester": "^2.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.13.1",
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cypress",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "h3@<=1.15.8": ">=1.15.9",
      "uuid": ">=14.0.0",
      "sharp@<0.35.0": "0.35.3",
      "postcss@<8.5.18": "8.5.23",
      "mailparser>linkify-it": "5.0.2",
      "minimatch>brace-expansion": "5.0.9",
      "undici@<7.29.0": "7.29.0",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "dompurify@<3.4.13": "3.4.13",
      "nanoid@<3.3.18": "3.3.18",
      "browserslist@<=4.28.6": "4.28.9",
      "qs@<6.16.0": "6.16.0"
    }
  }
}
